# Same Postgres instance team-management-api's ConnectionStrings:DefaultConnection points at
# (a Supabase Postgres project). Prefer a dedicated read-only role over the app's own
# migration credentials -- see README.md for the GRANT SELECT snippet.
DATABASE_URL=postgresql://user:password@host:5432/postgres

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared secret the ASP.NET Core gateway (AiController/AiService) sends as
# X-Internal-Api-Key on every forwarded request. Generate any long random string.
INTERNAL_API_KEY=
